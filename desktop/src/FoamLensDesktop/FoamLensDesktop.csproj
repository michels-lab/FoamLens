<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName Condition="'$(FoamLensDeveloper)' != 'true'">FoamLens</AssemblyName>
    <AssemblyName Condition="'$(FoamLensDeveloper)' == 'true'">FoamLensDeveloper</AssemblyName>
    <RootNamespace>FoamLensDesktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FoamLens.ico</ApplicationIcon>
    <Version>1.8.10</Version>
    <AssemblyVersion>1.8.10.0</AssemblyVersion>
    <FileVersion>1.8.10.0</FileVersion>
    <Product Condition="'$(FoamLensDeveloper)' != 'true'">FoamLens Desktop</Product>
    <Product Condition="'$(FoamLensDeveloper)' == 'true'">FoamLens Developer</Product>
    <Company>Michel's Lab</Company>
    <Authors>Michel Armando Duarte Flores</Authors>
    <Description>Native Windows host for FoamLens OpenFOAM Analysis Workspace.</Description>
    <DefineConstants Condition="'$(FoamLensStoreChannel)' == 'true'">$(DefineConstants);FOAMLENS_STORE</DefineConstants>
    <DefineConstants Condition="'$(FoamLensDeveloper)' == 'true'">$(DefineConstants);FOAMLENS_DEVELOPER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup Condition="'$(FoamLensDeveloper)' == 'true'">
    <EmbeddedResource Include="Developer\Audit.js">
      <LogicalName>FoamLensDesktop.Developer.Audit.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AppBundle.zip">
      <LogicalName>FoamLensDesktop.AppBundle.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="frontend\assets\branding\official-app-icon.svg">
      <LogicalName>FoamLensDesktop.Branding.official-app-icon.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="frontend\assets\branding\official-mark.svg">
      <LogicalName>FoamLensDesktop.Branding.official-mark.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="frontend\assets\branding\official-lockup.svg">
      <LogicalName>FoamLensDesktop.Branding.official-lockup.svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
